# Local mode: run browsers as kernel-images containers on this Linux host (see docs/local-mode.md).
# Leave KERNEL_PROJECT unset (or set it to "local"). No Clerk, Redis or Kernel cloud keys are needed.

# Switches local mode on.
KERNEL_MODE=local
# name:token pairs, comma separated. The token picks the browser owner. Tokens must not look like a JWT (no two dots).
LOCAL_MCP_TOKENS=me:change-me
# Browser image. Pull it once with docker pull; containers start with --pull never.
KERNEL_LOCAL_IMAGE=onkernel/chromium-headful:c1128b7
# Profiles are stored under <dir>/profiles/.
KERNEL_LOCAL_DATA_DIR=./.local-data
# Host name used in cdp_ws_url.
KERNEL_LOCAL_PUBLIC_HOST=localhost
# Cap on running browser containers across all owners.
KERNEL_LOCAL_MAX_BROWSERS=5
